{
  "name": "brbpro",
  "version": "1.0.0",
  "description": "BRB Pro — SaaS multi-tenant para barbearias. brbpro.com.br + *.brbpro.com.br",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "psql $DATABASE_URL -f migration.sql",
