{
  "name": "brbpro",
  "version": "1.0.0",
  "description": "BRB Pro — SaaS multi-tenant para barbearias. brbpro.com.br + *.brbpro.com.br",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node -e \"require('dotenv').config();require('fs');const{Pool}=require('pg');const p=new Pool({connectionString:process.env.DATABASE_URL,ssl:{rejectUnauthorized:false}});p.query(require('fs').readFileSync('db/migration-multi-tenant.sql','utf8')).then(()=>{console.log('Migração OK');return p.end()}).catch(e=>{console.error(e);process.exit(1)})\"",
    "hash": "node -e \"console.log(require('bcrypt').hashSync(process.argv[1],12))\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
