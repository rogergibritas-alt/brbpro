# BRB Pro — Variáveis de Ambiente (Render → Environment)
# Copie para .env local e preencha. No Render, cole em Environment → Add Variable

# Obrigatórias
JWT_SECRET=troque-por-64-chars-aleatorios-gerados-com-openssl-rand-hex-32
ADMIN_SENHA=vitinh@continue
# Se usar Postgres (recomendado para SaaS):
# DATABASE_URL=postgres://user:pass@host:5432/brbpro
# Se não definir, usa memória + JSON (bom para teste)

# Opcionais
PORT=3000
NODE_ENV=production
ORIGIN_FALLBACK=https://art-na-regua.onrender.com
# Para Cloudflare Worker (se Render não aceitar wildcard):
# ORIGIN_HOST=art-na-regua.onrender.com

# Para gerar hash de nova senha:
# npm run hash "minhaNovaSenha@123"
